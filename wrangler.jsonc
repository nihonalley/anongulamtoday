{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "anongulamtoday",

  "main": "worker/index.js",

  "compatibility_date": "2026-08-19",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "db",
      "database_name": "anongulamdb",
      "database_id": "da9fee4d-7e38-40b9-a009-d7ce067111ca",
      "remote": true
    }
  ]
}